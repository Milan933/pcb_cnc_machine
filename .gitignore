*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local secrets and credentials. Public examples may be explicitly re-added.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials
credentials.*
credentials-*
secrets
secrets.*
secrets-*
*.secret
*.token

# Python environments and local build state.
.venv/
venv/
env/
ENV/
build/
dist/
.cache/
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Machine-specific and IDE state.
.idea/workspace.xml
.idea/**/workspace.xml
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
*.user
*.suo
.DS_Store
Thumbs.db
*.log

# Generated outputs default to ignored so temporary/intermediate work cannot be
# published accidentally. Useful reviewed engineering artifacts may be
# explicitly allowlisted below; generated/binary does not by itself mean
# disposable or prohibited.
generated/step/*
!generated/step/.gitkeep
!generated/step/release/
!generated/step/release/**
generated/stl/*
!generated/stl/.gitkeep
!generated/stl/release/
!generated/stl/release/**
generated/drawings/*
!generated/drawings/.gitkeep
!generated/drawings/release/
!generated/drawings/release/**

# Owner-authorized current Phase 5 engineering deliverables. These are useful
# versioned artifacts, not production-release claims. The complete-machine
# scene STL files under drawings/scene-stl remain disposable render inputs.
!generated/step/phase5-complete-machine/
!generated/step/phase5-complete-machine/**
!generated/stl/phase5-complete-machine/
!generated/stl/phase5-complete-machine/**
!generated/drawings/phase5-complete-machine/
!generated/drawings/phase5-complete-machine/*.png
!generated/drawings/phase5-complete-machine/*.jpg
!generated/drawings/phase5-complete-machine/*.jpeg
!generated/drawings/phase5-complete-machine/*.webp
generated/drawings/phase5-complete-machine/scene-stl/

# Local CAD viewer and editor state.
.cadquery/
.build123d/
